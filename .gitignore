# ==============================================================================
# Security & Environment Variables
# NEVER commit real credentials, API keys, or secret tokens to version control
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Allow committing the sanitized example template
!.env.example

# ==============================================================================
# Dependencies & Package Managers
# ==============================================================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.js

# ==============================================================================
# Hosting & Deployment Artifacts
# ==============================================================================
.vercel
dist/
build/
out/
.output/

# ==============================================================================
# Logs, Diagnostics & Cache
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic & Testing reports
coverage/
.nyc_output/
reports/
sbom.cdx.json
test_injection.txt

# ==============================================================================
# Operating System & IDE Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE configuration folders
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace

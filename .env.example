# ==============================================================================
# ClearComms Aviation English (CCAE) Portfolio - Environment Configuration
# ==============================================================================
# COPY THIS FILE to `.env` (or `.env.local`) and fill in your actual values.
# NEVER commit `.env` or `.env.local` containing actual API keys or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE CONFIGURATION (Safe for browser / vanilla frontend)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key
# Protected by Row Level Security (RLS) - insert-only permissions for public requests
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-public-anon-key"

# Cal.com Booking Link / Username
# e.g., "munir-ccae/free-30min-consultation" or full custom embed link
CALCOM_BOOKING_URL="https://cal.com/your-username/free-30min"


# ------------------------------------------------------------------------------
# 2. SERVERLESS BACKEND & WEBHOOK SECRETS (Vercel Functions - SERVER ONLY)
# DO NOT EXPOSE TO CLIENT / BROWSER JAVASCRIPT
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - used strictly inside serverless function)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Cal.com Webhook Signing Secret (Used to cryptographically verify incoming booking events)
CALCOM_WEBHOOK_SECRET="your-calcom-webhook-signing-secret"

# CallMeBot WhatsApp Notification Service
# Phone number with international country code (e.g., +60123456789 for Malaysia)
CALLMEBOT_PHONE="+601XXXXXXXX"

# CallMeBot WhatsApp API Key (Obtained via CallMeBot bot on WhatsApp)
CALLMEBOT_API_KEY="your-callmebot-api-key"


# ------------------------------------------------------------------------------
# 3. SITE & ENVIRONMENT METADATA
# ------------------------------------------------------------------------------
# Base deployment URL
SITE_URL="http://localhost:3000"
NODE_ENV="development"
